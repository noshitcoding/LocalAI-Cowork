{
  "name": "localai-cowork",
  "private": true,
  "version": "0.3.3",
  "description": "Open-source, local-first AI coworker for Windows and Linux with Ollama, MCP, tasks, approvals, and tools.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/noshitcoding/LocalAI-Cowork.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:tauri": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview:tauri": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "prepare:crew-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-crew-runtime.ps1",
    "prepare:codex-runtime": "node ./scripts/prepare-codex-runtime.mjs",
    "prepare:local-daemon": "node ./scripts/prepare-local-daemon.mjs",
    "build:tauri": "npm run prepare:crew-runtime && npm run prepare:codex-runtime && npm run prepare:local-daemon && npm run build",
    "doctor": "node ./scripts/doctor.mjs",
    "doctor:ci": "node ./scripts/doctor.mjs --ci",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run typecheck && vite build --mode web",
    "contracts:generate": "node ./scripts/generate-contract-artifacts.mjs",
    "contracts:check": "node ./scripts/generate-contract-artifacts.mjs --check",
    "budgets:build": "node ./scripts/check-budgets.mjs",
    "brand:assets": "node ./scripts/generate-brand-assets.mjs",
    "brand:verify": "node ./scripts/verify-carbon-signal.mjs",
    "marketing:screenshot": "npm run build && node ./scripts/capture-marketing-preview.mjs",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "smoke:desktop": "node ./scripts/desktop-smoke.mjs",
    "smoke:authenticode": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/authenticode-smoke.ps1",
    "security:npm": "npm audit --audit-level=high",
    "supply-chain:check": "node ./scripts/supply-chain.mjs check",
    "supply-chain:sbom": "node ./scripts/supply-chain.mjs sbom",
    "supply-chain:release": "node ./scripts/supply-chain.mjs release",
    "tauri": "tauri",
    "test": "vitest",
    "test:scripts": "node --test ./scripts/create-updater-manifest.test.mjs ./scripts/installer-native-sandbox.test.mjs ./scripts/process-utils.test.mjs ./scripts/release-metadata.test.mjs ./scripts/supply-chain.test.mjs ./scripts/verify-codex-bundle.test.mjs",
    "test:ci": "vitest run",
    "test:gateway": "node ../scripts/test-gateway-e2e.mjs",
    "test:browser-session": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-browser-session.ps1",
    "test:storage-chaos": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-storage-chaos.ps1",
    "test:storage-pressure": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-storage-pressure.ps1",
    "test:local-daemon": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-local-daemon-lifecycle.ps1",
    "test:web": "npm run build:web && playwright test -c playwright.web.config.ts e2e/web-runtime.spec.ts",
    "test:ui": "npm run build && npm run budgets:build && playwright test",
    "test:ui:update": "npm run build && npm run budgets:build && playwright test --update-snapshots",
    "i18n:audit": "node ./scripts/i18n-audit.mjs",
    "verify": "node ./scripts/verify.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "snarkdown": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
