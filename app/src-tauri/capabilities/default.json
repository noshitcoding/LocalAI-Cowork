{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "deep-link:default",
    "notification:default",
    "opener:default",
    "process:allow-restart",
    "updater:default"
  ]
}
