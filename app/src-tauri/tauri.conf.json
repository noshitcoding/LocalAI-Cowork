{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Local AI Cowork",
  "version": "0.3.4",
  "identifier": "io.noshitcoding.opencowork",
  "build": {
    "beforeDevCommand": "npm run prepare:crew-runtime && npm run prepare:codex-runtime && npm run prepare:local-daemon && npm run dev:tauri",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png"
    },
    "windows": [
      {
        "title": "Local AI Cowork",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/pdfium/bin/pdfium.dll": "resources/pdfium/bin/pdfium.dll",
      "resources/pdfium/LICENSE": "resources/pdfium/LICENSE",
      "resources/pdfium/VERSION": "resources/pdfium/VERSION",
      "python/crew_runtime/main.py": "python/crew_runtime/main.py",
      "python/crew_runtime/crew_tools.py": "python/crew_runtime/crew_tools.py",
      "python/crew_runtime/requirements.txt": "python/crew_runtime/requirements.txt",
      "python/crew_runtime/requirements.lock": "python/crew_runtime/requirements.lock",
      "python/crew_runtime/wheels.zip": "python/crew_runtime/wheels.zip",
      "python/crew_runtime/runtime-bundle-manifest.json": "python/crew_runtime/runtime-bundle-manifest.json",
      "resources/python/windows.zip": "python/windows.zip",
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "resources/codex": "codex",
      "resources/daemon": "daemon"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["open-cowork"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["open-cowork"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRTY2QTNENkM1Njg4ODEKUldTQmlGWnNQV3JtbnQzeStLUlZyM0dnLytXMGVpaTBDUFFoOG85Mnc0Nm1ldWFpSkhvd0hCMVAK",
      "endpoints": [
        "https://github.com/noshitcoding/LocalAI-Cowork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
