COWORK_SERVER_URL=https://cowork.example.com
COWORK_AGENT_TOKEN_FILE=C:\OpenCowork\agent-token.txt
COWORK_EXECUTOR_ID=00000000-0000-0000-0000-000000000010
COWORK_AGENT_KIND=personal_device
COWORK_EXECUTOR_NAME=My laptop
COWORK_AGENT_CAPABILITIES=model.ollama,files,shell,git,web,mcp,browser.headless
# off | confirm_each_session (default) | unattended
COWORK_PERSONAL_REMOTE_CONTROL=confirm_each_session
# Connect the outbound server agent to the already running desktop daemon. The
# executor ID above must be identical to COWORK_DAEMON_DEVICE_ID. On Linux use
# $XDG_RUNTIME_DIR/open-cowork/daemon.sock (or the daemon data-dir socket).
COWORK_LOCAL_DAEMON_IPC_ENDPOINT=\\.\pipe\open-cowork-me
COWORK_LOCAL_DAEMON_IPC_TOKEN_FILE=C:\Users\me\AppData\Local\OpenCowork\daemon\ipc-token.txt
# These model values are forwarded into the daemon for server-originated runs.
# If omitted, the daemon's own local model configuration is used.
COWORK_MODEL_BASE_URL=http://127.0.0.1:11434/v1
COWORK_MODEL_NAME=qwen3:8b

# Managed Windows executors additionally require:
# COWORK_AGENT_KIND=managed_windows
# COWORK_EXECUTOR_POOL_ID=00000000-0000-0000-0000-000000000020
# COWORK_AGENT_CAPABILITIES=office.microsoft,desktop.windows
# COWORK_AGENT_WORKSPACE_ROOT=C:\OpenCowork\Runs
