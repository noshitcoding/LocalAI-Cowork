# lifecycle.py init generates private secrets and the actual values.
COWORK_DEPLOY_ROOT=/srv/localai-cowork
COWORK_SOURCE_ROOT=/srv/source/LocalAI-Cowork-V2
COWORK_PROJECT=localai-cowork-owned-instance
COWORK_IMAGE=localai-cowork-v2:local
COWORK_SITE=cowork.example.com
COWORK_UID=1000
COWORK_GID=1000
COWORK_S3_REGION=us-east-1
# Exact comma-separated HTTP(S) origins permitted for remote team MCP. Empty denies all.
COWORK_TEAM_MCP_ALLOWED_ORIGINS=
# Exact internal HTTP origins permitted for team LiteLLM. HTTPS needs no exception.
COWORK_TEAM_LITELLM_HTTP_ORIGINS=
# External S3: set endpoint/bucket and explicit key FILE variables in your override.

# Optional passkeys: exact HTTPS origin and its exact DNS host; set both together.
COWORK_PASSKEY_ORIGIN=
COWORK_PASSKEY_RP_ID=
# Optional FCM v1: container path under COWORK_DATA_DIR, owned by daemon UID, mode 0600.
# Example: /var/lib/cowork/fcm-service-account.json. The file is supplied by the operator.
COWORK_FCM_SERVICE_ACCOUNT_FILE=

# Optional existing fleet federation: private key file under COWORK_DATA_DIR.
# Team is an existing V2 team UUID; instance is this operator's explicit UUID.
COWORK_FLEET_KEY_FILE=
COWORK_ORGANISATION_ID=
COWORK_INSTANCE_ID=
