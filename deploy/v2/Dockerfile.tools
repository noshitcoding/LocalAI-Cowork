# Explicit team-tool guest: no daemon, database, operator keys or host socket.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-venv python3-docx python3-openpyxl python3-pypdf \
    python3-reportlab chromium libreoffice-writer libreoffice-calc \
    libreoffice-impress git gh fonts-dejavu-core fonts-noto-core \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/local/bin/node /usr/bin/node
ARG PLAYWRIGHT_VERSION=1.58.0
ARG PYTHON_PPTX_VERSION=1.0.2
RUN python3 -m venv --copies --system-site-packages /opt/cowork/python \
    && /opt/cowork/python/bin/pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" "python-pptx==${PYTHON_PPTX_VERSION}"
# Same document wheels and pinned Tectonic/offline LaTeX cache as the server image (team runs: phase 3).
COPY tools/toolbox/requirements-documents.lock tools/toolbox/runtime_install.py /opt/cowork/setup/
RUN /opt/cowork/python/bin/pip install --no-cache-dir --require-hashes --only-binary=:all: --no-deps \
    -r /opt/cowork/setup/requirements-documents.lock \
    && /usr/bin/python3 -I /opt/cowork/setup/runtime_install.py --data-dir /opt/cowork/document-runtime --tectonic-only \
    && ln -s "$(/usr/bin/python3 -I -c 'import json;print(json.load(open("/opt/cowork/document-runtime/toolbox.json"))["programs"]["tectonic"])')" /usr/local/bin/tectonic \
    && rm -rf /opt/cowork/document-runtime/tool-runtime/tmp /opt/cowork/document-runtime/tool-runtime/home \
    && chmod -R a+rX,go-w /opt/cowork/document-runtime
ENV COWORK_DOCUMENT_RUNTIME_DIR=/opt/cowork/document-runtime/tool-runtime
COPY crates/toolbox/src/browser.py crates/toolbox/src/office.py /opt/cowork-team-tools/
COPY deploy/v2/team-tool-guest.py /opt/cowork-team-tools/guest.py
COPY deploy/v2/android-private-guest.py /opt/cowork-private-tools/guest.py
COPY crates/toolbox/src/office.py /opt/cowork-private-tools/office.py
COPY deploy/v2/android-private-browser.py /opt/cowork-private-tools/browser.py
COPY deploy/v2/android-private-terminal.py /opt/cowork-private-tools/terminal.py
COPY deploy/v2/android-private-github.py /opt/cowork-private-tools/github.py
COPY deploy/v2/android-private-crew.py /opt/cowork-private-tools/crew.py
COPY deploy/v2/team-github-repository.py /opt/cowork-team-tools/github_repository.py
COPY deploy/v2/team-browser-session.py /opt/cowork-team-tools/browser_session.py
ENV PATH=/opt/cowork/python/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 HOME=/tmp/home TMPDIR=/tmp PYTHONUNBUFFERED=1
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/opt/cowork/python/bin/python","-I","/opt/cowork-team-tools/guest.py"]
