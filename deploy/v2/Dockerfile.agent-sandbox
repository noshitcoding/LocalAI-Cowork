# syntax=docker/dockerfile:1.18
# Build target workload: Kubernetes/Kata guest. Build target runner: trusted API.
# Named build context agent_sandbox must be the fixed upstream v1.0.7 commit.
ARG GO_IMAGE=golang@sha256:162be5298a40ed317005c8339c6de4d10d3eef336d66dc8e9259b03ab9d3a6d2
ARG RUST_IMAGE=rust@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55
ARG NODE_IMAGE=node@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5
ARG RUNNER_BASE_IMAGE=debian@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG DOCKER_CLI_IMAGE=docker@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${GO_IMAGE} AS sandboxd-build
COPY --from=agent_sandbox / /upstream
WORKDIR /upstream
ARG TARGETARCH
RUN GOMAXPROCS=2 CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -p 2 -trimpath \
    -ldflags="-s -w -X sigs.k8s.io/agent-sandbox/internal/version.gitVersion=v1.0.7 -X sigs.k8s.io/agent-sandbox/internal/version.gitSHA=807cc37107bd7c012115afac9fa9c3b77b8365c2" \
    -o /sandboxd ./packages/sandboxd/cmd/sandboxd

FROM ${RUST_IMAGE} AS runner-build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY services services
COPY tools/contracts tools/contracts
COPY tools/migration/v1_sqlite_export.py tools/migration/schema_profiles.py tools/migration/
COPY deploy/v2/android-private-crew.py deploy/v2/android-private-crew.py
ARG CARGO_TARGET_CACHE=cowork-agent-sandbox-cargo-target
# A copied/frozen source context may predate a different build's cached target
# timestamps. Serialize cache writers and refresh all workspace/include inputs
# inside that lock so Cargo cannot reuse a stale local crate by mtime alone.
RUN --mount=type=cache,id=cowork-agent-sandbox-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cowork-agent-sandbox-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=${CARGO_TARGET_CACHE},target=/build/target,sharing=locked \
    find crates services tools/contracts tools/migration deploy/v2 -type f -exec touch {} + \
    && cargo build --release --locked --jobs 2 -p cowork-process-runner -p cowork-sandbox-preview --bins \
    && mkdir -p /out \
    && cp target/release/cowork-process-runner target/release/cowork-runner-probe target/release/cowork-sandbox-preview /out/

FROM runner-build AS local-app-build
RUN --mount=type=cache,id=cowork-agent-sandbox-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cowork-agent-sandbox-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=${CARGO_TARGET_CACHE},target=/build/target,sharing=locked \
    find crates services tools/contracts tools/migration deploy/v2 -type f -exec touch {} + \
    && cargo build --release --locked --jobs 2 -p cowork-daemon --bin cowork-daemon \
    && cp target/release/cowork-daemon /out/cowork-daemon

FROM ${NODE_IMAGE} AS workload
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates procps coreutils python3 python3-venv python3-docx python3-openpyxl \
    python3-pypdf python3-reportlab chromium libreoffice-writer \
    libreoffice-calc libreoffice-impress git gh fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace && chown 1000:1000 /workspace
ARG PLAYWRIGHT_VERSION=1.58.0
ARG PYTHON_PPTX_VERSION=1.0.2
RUN python3 -m venv --copies --system-site-packages /opt/cowork/python \
    && /opt/cowork/python/bin/pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" "python-pptx==${PYTHON_PPTX_VERSION}"
COPY --from=sandboxd-build /sandboxd /usr/local/bin/sandboxd
COPY --from=runner-build /out/cowork-runner-probe /usr/local/bin/cowork-runner-probe
COPY crates/toolbox/src/browser.py crates/toolbox/src/office.py /opt/cowork-tools/
LABEL org.opencontainers.image.vendor="LocalAI Cowork" \
      cowork.agent-sandbox.version="v1.0.7" \
      cowork.agent-sandbox.revision="807cc37107bd7c012115afac9fa9c3b77b8365c2"
ENV PATH=/opt/cowork/python/bin:/usr/local/bin:/usr/bin:/bin HOME=/tmp/home LANG=C.UTF-8
USER 1000:1000
WORKDIR /workspace
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/sandboxd"]

FROM ${RUNNER_BASE_IMAGE} AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 coreutils openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 cowork && useradd -u 1000 -g cowork -m cowork
COPY --from=runner-build /out/cowork-process-runner /usr/local/bin/cowork-process-runner
COPY --from=runner-build /out/cowork-runner-probe /usr/local/bin/cowork-runner-probe
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
USER 1000:1000
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/cowork-process-runner"]

FROM ${RUNNER_BASE_IMAGE} AS preview
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 cowork && useradd -u 1000 -g cowork -m cowork
COPY --from=runner-build /out/cowork-sandbox-preview /usr/local/bin/cowork-sandbox-preview
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/cowork-sandbox-preview"]

# API-only localhost execution location; use the desktop's existing connection
# screen. The full web/frontend image remains deploy/v2/Dockerfile.
FROM ${RUNNER_BASE_IMAGE} AS local-app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 cowork && useradd -u 1000 -g cowork -m cowork
COPY --from=local-app-build /out/cowork-daemon /usr/local/bin/cowork-daemon
ENV COWORK_DATA_DIR=/var/lib/cowork/data COWORK_BIND_ADDRESS=0.0.0.0 COWORK_PORT=43822
USER 1000:1000
EXPOSE 43822
ENTRYPOINT ["/usr/local/bin/cowork-daemon"]
