# The gateway is the only published HTTP port. Keep 127.0.0.1 when Nginx
# Proxy Manager reaches it through the host; choose an explicit private address
# or a shared Docker network when proxying container-to-container.
COWORK_BIND_ADDRESS=127.0.0.1
COWORK_HTTP_PORT=8080
# Canonical browser origin and WebAuthn relying-party ID. These values are
# permanent credential bindings; changing the RP ID invalidates passkeys.
COWORK_PUBLIC_ORIGIN=https://cowork.example.com
COWORK_WEBAUTHN_RP_ID=cowork.example.com

# Optional OpenID Connect. Register this exact redirect URI at the provider:
# https://cowork.example.com/api/v1/auth/oidc/callback
# Start Compose with the docker-compose.oidc.yml overlay when enabled.
COWORK_OIDC_ISSUER=https://identity.example.com
COWORK_OIDC_CLIENT_ID=open-cowork
COWORK_OIDC_AUTO_PROVISION=false
COWORK_OIDC_CLIENT_SECRET_PATH=./secrets/oidc_client_secret.txt

# Server-side model execution uses an external OpenAI-compatible API.
COWORK_MODEL_BASE_URL=https://api.openai.com/v1
COWORK_MODEL_API_KEY=
COWORK_MODEL_NAME=gpt-5-mini
# Optional exact provider prices in millionths of the deployment currency per
# one million tokens. Configure both values together; otherwise cost usage stays
# unknown and the mandatory token quota remains the hard fallback.
COWORK_MODEL_INPUT_COST_MICROS_PER_MILLION=
COWORK_MODEL_OUTPUT_COST_MICROS_PER_MILLION=
COWORK_SERVER_CAPABILITIES=model.external,crew.python,files,shell,git,web.fetch,tool.mcp.invoke,browser.headless,browser.visible,desktop.linux,office.ooxml,office.libreoffice

# The production Linux runner refuses to become healthy without Seccomp and
# the named AppArmor profile. Install the repository profile before Compose.
COWORK_SANDBOX_SECCOMP_PROFILE=builtin
COWORK_SANDBOX_APPARMOR_PROFILE=open-cowork-sandbox
COWORK_SANDBOX_REQUIRE_APPARMOR=true

COWORK_LOG_LEVEL=cowork_server=info,tower_http=info
COWORK_LEASE_SECONDS=90
# Run retention and object-store maintenance after this many worker polls.
COWORK_MAINTENANCE_EVERY_POLLS=60
COWORK_VERSION=0.3.0
# Published releases default to the GHCR images below. Override only for an
# internal registry or a source-built deployment.
COWORK_SERVER_IMAGE=ghcr.io/noshitcoding/open-cowork-server
COWORK_RUNNER_IMAGE=ghcr.io/noshitcoding/open-cowork-runner
COWORK_WEB_IMAGE=ghcr.io/noshitcoding/open-cowork-web
COWORK_EGRESS_PROXY_IMAGE=ghcr.io/noshitcoding/open-cowork-egress-proxy
COWORK_SANDBOX_CORE_IMAGE=ghcr.io/noshitcoding/open-cowork-sandbox-core
COWORK_SANDBOX_GUI_IMAGE=ghcr.io/noshitcoding/open-cowork-sandbox-gui
COWORK_SANDBOX_CREW_IMAGE=ghcr.io/noshitcoding/open-cowork-sandbox-crew
COWORK_WEB_PUSH_ENABLED=true
COWORK_WEB_PUSH_SUBJECT=mailto:admin@example.com

# Secret file locations, relative to deploy/docker-compose.yml.
COWORK_BOOTSTRAP_TOKEN_PATH=./secrets/bootstrap_token.txt
COWORK_DATABASE_URL_PATH=./secrets/database_url.txt
COWORK_POSTGRES_PASSWORD_PATH=./secrets/postgres_password.txt
COWORK_MINIO_ROOT_USER_PATH=./secrets/minio_root_user.txt
COWORK_MINIO_ROOT_PASSWORD_PATH=./secrets/minio_root_password.txt
COWORK_RUNNER_SIGNING_KEY_PATH=./secrets/runner_signing_key.txt
COWORK_STORAGE_MASTER_KEY_PATH=./secrets/storage_master_key.txt
COWORK_S3_REGION=us-east-1
COWORK_S3_BUCKET=cowork-blobs
# path for bundled MinIO; virtual_hosted for AWS/R2-style DNS endpoints.
COWORK_S3_ENDPOINT=http://minio:9000
COWORK_S3_ADDRESSING_STYLE=path
# Optional image overrides used by the version-compatibility matrix.
COWORK_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
COWORK_MINIO_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z@sha256:aead63c77f9db9107f1696fb08ecb0faeda23729cde94b0f663edf4fe09728e3
