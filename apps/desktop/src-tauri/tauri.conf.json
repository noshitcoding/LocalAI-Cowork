{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalAI Cowork V2 Preview",
  "version": "2.0.0-alpha.8",
  "identifier": "dev.localai.cowork.v2.preview",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "build": {
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalAI Cowork V2",
        "width": 1440,
        "height": 960,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https: wss: ws://127.0.0.1:* ws://localhost:*; frame-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/update-hooks.nsh",
        "languages": [
          "English",
          "German"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)"
        ]
      }
    },
    "resources": {
      "vendor/glib/LICENSE": "licenses/glib/LICENSE",
      "vendor/glib/COPYRIGHT": "licenses/glib/COPYRIGHT",
      "vendor/README.md": "licenses/glib/README.md"
    },
    "externalBin": [
      "binaries/cowork-daemon",
      "binaries/cowork-browser-host"
    ]
  }
}
