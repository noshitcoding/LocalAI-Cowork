{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Cowork",
  "version": "0.3.0",
  "identifier": "dev.opencowork.android",
  "build": {
    "beforeDevCommand": "npm --prefix ../../app run dev -- --mode android",
    "beforeBuildCommand": "npm --prefix ../../app run build -- --mode android",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Cowork",
        "width": 412,
        "height": 915,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 28
    },
    "icon": [
      "../../../app/src-tauri/icons/32x32.png",
      "../../../app/src-tauri/icons/128x128.png",
      "../../../app/src-tauri/icons/icon.png",
      "../../../app/src-tauri/icons/icon.ico"
    ]
  }
}
