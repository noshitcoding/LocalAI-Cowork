[Unit]
Description=Open Cowork per-user daemon
After=default.target

[Service]
Type=simple
EnvironmentFile=%h/.config/open-cowork/daemon.env
ExecStart=%h/.local/bin/cowork-local-daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/open-cowork

[Install]
WantedBy=default.target
