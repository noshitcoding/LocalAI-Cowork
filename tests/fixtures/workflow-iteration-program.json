            "max_output_tokens": 256,
            "max_total_tokens": 8192
          },
          "roles": [],
          "steps": [],
          "controls": {
            "echo": {
              "name": "Copy selected input",
              "dependencies": [],
              "operation": {
                "kind": "compose"
              }
            }
          },
          "dataflow": {
            "input": {
              "type": "object",
              "fields": {
                "amount": {
                  "type": "integer"
                }
              }
            },
