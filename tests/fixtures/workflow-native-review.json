  "roles": [],
  "steps": [],
  "controls": {
    "review": {
      "name": "Check invoice",
      "dependencies": [],
      "operation": {
        "kind": "review",
        "form": {
          "question": "Check the invoice fields before booking.",
          "fields": {
            "invoice": {
              "label": "Invoice number",
              "help": "Compare with the source invoice.",
              "value_type": {
                "type": "nullable",
                "value": {
                  "type": "text"
                }
              },
              "format": "value",
              "required": true,
              "minimum": null,
              "maximum": null
            },
            "issued": {
              "label": "Issued on",
              "help": "Compare with the source invoice.",
              "value_type": {
                "type": "nullable",
                "value": {
                  "type": "text"
                }
              },
              "format": "date",
              "required": true,
              "minimum": null,
              "maximum": null
            },
            "net_minor": {
              "label": "Net amount",
              "help": "Compare with the source invoice.",
              "value_type": {
                "type": "nullable",
                "value": {
                  "type": "integer"
                }
              },
              "format": "money_minor",
              "required": true,
              "minimum": 0,
              "maximum": null
            },
            "tax_minor": {
              "label": "Tax amount",
              "help": "Compare with the source invoice.",
              "value_type": {
                "type": "nullable",
                "value": {
                  "type": "integer"
                }
              },
              "format": "money_minor",
              "required": true,
              "minimum": 0,
              "maximum": null
            },
            "gross_minor": {
              "label": "Gross amount",
              "help": "Compare with the source invoice.",
              "value_type": {
                "type": "nullable",
                "value": {
                  "type": "integer"
                }
              },
              "format": "money_minor",
              "required": true,
              "minimum": 0,
              "maximum": null
            }
          },
          "checks": [
            {
              "kind": "sum",
              "terms": [
                "net_minor",
                "tax_minor"
              ],
              "total": "gross_minor"
            }
          ]
        },
        "rights": {
          "tools": [
            "request_input"
          ],
          "folders": []
        }
      }
    }
  },
